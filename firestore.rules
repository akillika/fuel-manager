rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function willBeOwner() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /fillups/{id} {
      allow read, delete: if isOwner(resource.data.userId);
      allow update:       if isOwner(resource.data.userId) && willBeOwner();
      allow create:       if willBeOwner();
    }

    match /vehicles/{id} {
      allow read, delete: if isOwner(resource.data.userId);
      allow update:       if isOwner(resource.data.userId) && willBeOwner();
      allow create:       if willBeOwner();
    }

    match /services/{id} {
      allow read, delete: if isOwner(resource.data.userId);
      allow update:       if isOwner(resource.data.userId) && willBeOwner();
      allow create:       if willBeOwner();
    }

    match /fuelGoals/{id} {
      allow read, delete: if isOwner(resource.data.userId);
      allow update:       if isOwner(resource.data.userId) && willBeOwner();
      allow create:       if willBeOwner();
    }

    // Short-lived link codes the web app writes and the Telegram bot reads.
    // The bot uses admin credentials, so it bypasses rules.
    match /telegramLinks/{code} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create:       if willBeOwner();
    }

    // Telegram user records are created by the bot (admin-write) and readable
    // by the account owner to display "linked accounts" in the UI.
    match /telegramUsers/{telegramId} {
      allow read:   if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
